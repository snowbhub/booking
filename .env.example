# Local runtime. Copy this file to .env.local and fill in only what you need.

# Leave empty to run with the in-memory demo store. To use Supabase, provide
# the PostgreSQL URI from Supabase (server-side only; never expose it to browser).
DATABASE_URL=
DATA_SOURCE=demo

# Optional for local development. Set a private password for the panel.
PANEL_PASSWORD=

# Defaults to Europe/Berlin. Match the business timezone when using Supabase.
NEXT_PUBLIC_BOOKING_TIME_ZONE=Europe/Berlin
DEMO_CLOCK=real

# Optional integrations.
AGENT_PROVIDER=gemini
AGENT_MODEL=
AGENT_EFFORT=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ZERNIO_API_KEY=
ZERNIO_PROFILE_ID=
ZERNIO_ACCOUNT_ID=
ZERNIO_WEBHOOK_SECRET=
